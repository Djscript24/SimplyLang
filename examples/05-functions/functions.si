# Typed parameters, return values, and Unit-returning functions
fn greet(name as String):
    Say "Hello " + name
end

fn add(left as Int, right as Int) gives Int:
    return left + right
end

fn keep_rate(rate as Float) gives Float:
    return rate
end

greet("Alex")
total is add(10, 20)
Say total
Say keep_rate(0.85)
