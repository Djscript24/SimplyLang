# functions.si — function definitions example
# Demonstrates typed parameters, return values, and Unit-returning functions.
# Key components: greet, add, and keep_rate.
# Typed parameters, return values, and Unit-returning functions
fn greet(name as String):
    Sayln "Hello " + name
end

fn add(left as Int, right as Int) gives Int:
    return left + right
end

fn keep_rate(rate as Float) gives Float:
    return rate
end

greet("Alex")
total is add(10, 20)
Sayln total
Sayln keep_rate(0.85)
