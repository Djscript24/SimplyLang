# scope-and-short-circuit.si — scope and laziness example
# Demonstrates global reads, function-local shadowing, and lazy boolean expressions.
# Key components: scale, nested value binding, and and/or short circuits.
# Global reads, function-local shadowing, and lazy boolean expressions
factor is 3
value is 10

fn scale(value as Int) gives Int:
    local is value
    return local * factor
end

if true:
    value is "inner"
    Say value
end

Say scale(7)
Say value
Say false and missing_value
Say true or missing_value
