# conditionals.si — conditional branching example
# Demonstrates if, else if, and else branches over a score.
# Key components: ordered conditional selection.
# Branching with if, else if, and else
score is 87

if score >= 90:
    Sayln "excellent"
else if score >= 60:
    Sayln "passed"
else:
    Sayln "try again"
end
