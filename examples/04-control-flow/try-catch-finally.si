# try-catch-finally.si — structured runtime error handling
# Demonstrates throw, code-filtered catches, structured error fields, and cleanup.
try:
    throw "custom failure"
catch ignored as E0202:
    Sayln "wrong handler"
catch error:
    Sayln error.message
finally:
    Sayln "cleanup complete"
end

try:
    try:
        throw "inner failure"
    finally:
        Sayln "inner cleanup"
    end
catch error:
    Sayln "outer caught: " + error.message
finally:
    Sayln "outer cleanup"
end
