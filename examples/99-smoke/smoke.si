# smoke.si — end-to-end smoke test
# Combines declarations, imports, functions, collections, pipelines, and conditionals in one runnable check.
# Key components: total, greet, filtered_total, and the final pass/fail branch.
# Compact end-to-end check for the Simply language
name as String is "Simply"
values is array [5, 10, 15]

open "../08-standard-library/imported-values.si" as imported_values

flow total from values:
    sum
end

filtered_total is pipeline:
    imported_values
    where item >= 20
    sum
end

person is hash:
    name is "Ada"
end

if total == 30 and filtered_total == 50 and person["name"] == "Ada" and name == "Simply":
    Sayln "Smoke test passed"
else:
    Sayln "Smoke test failed"
end
