# csv-cleanup.si — streaming CSV Flow with formulas
# The fixture is kept under 99-bench because it is also a benchmark input.
flow cleaned from csv_rows("examples/99-bench/random-large.csv"):
    where item[4] == "ok"
    derive csv_row(item[0], item[1], item[2], round(clamp(to_float(item[3]) * 1.1, 0.0, 10000.0), 2), item[4], trim(item[5]))
    write_csv("/tmp/simply-flow-cleaned.csv")
end

Sayln "CSV cleanup complete"
