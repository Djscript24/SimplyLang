# matrix-workload.si — matrix workload benchmark
# Measures repeated matrix multiplication and transpose operations.
# Key components: 3x3 matrices and a 100-iteration workload.
# Runtime benchmark workload: repeated matrix multiplication and transpose
left is matrix [[1, 2, 3], [4, 5, 6], [7, 8, 9]]
right is matrix [[9, 8, 7], [6, 5, 4], [3, 2, 1]]

mut index is 0
mut result is left
while index < 100:
    result -> result multiply right
    result -> result transpose
    index -> index + 1
end

Say result[0, 0]
