# arrays-lists.si — array and list example
# Demonstrates fixed-length arrays and mutable list operations.
# Key components: indexing, add, remove, and collection output.
# Fixed-length arrays and mutable lists
cities is array ["Jakarta", "Citra", "Lima"]
mut queue is list ["first", "second"]

queue add "third"
queue remove "first"

Sayln cities
Sayln queue
Sayln range(0, 10, 3)
Sayln range(10, 0, -3)

for entry in enumerate(cities):
    Sayln entry
end

for pair in zip(cities, range(1, 4)):
    Sayln pair
end
