# hash-tree.si — hash and tree example
# Demonstrates named fields, string indexing, and nested collection values.
# Key components: profile hash and catalog tree.
# Hashes and trees support fields, string indexing, and nesting
profile is hash:
    name is "Ada"
    role is "builder"
end

catalog is tree:
    featured is profile
end

Sayln profile.name
Sayln profile["role"]
Sayln catalog["featured"].name
Sayln keys(profile)
Sayln values(profile)
Sayln entries(profile)
Sayln has_key(profile, "role")
Sayln has_key(profile, "missing")
Sayln get(profile, "role", "unknown")
Sayln get(profile, "missing", "unknown")
Sayln keys(without_key(profile, "role"))
Sayln keys(profile)
Sayln entries(select_keys(profile, ["role", "name"]))
