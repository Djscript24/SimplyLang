# strings.si — string built-ins example
# Demonstrates trimming, splitting, replacement, and prefix/suffix checks.
# Key components: text cleanup and string predicates.
# String cleanup, splitting, replacement, and prefix/suffix checks
text is "  Ada,Lin  "
clean is trim(text)

Sayln clean
Sayln split(clean, ",")
Sayln replace(text, "Ada", "Citra")
Sayln starts_with(clean, "Ada")
Sayln ends_with(clean, "Lin")
